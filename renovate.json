{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "timezone": "America/Los_Angeles",
  "platformAutomerge": false,
  "minimumReleaseAge": "14 days",
  "lockFileMaintenance": {
    "schedule": [
      "at any time"
    ],
    "minimumReleaseAge": null
  },
  "packageRules": [
    {
      "matchDatasources": [
        "npm"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ],
      "minimumReleaseAge": "14 days"
    },
    {
      "groupName": "Routine updates",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "changelog-github's template option is experimental. Review its updates by hand.",
      "matchPackageNames": ["@changesets/changelog-github"],
      "groupName": "Changesets changelog",
      "automerge": false
    }
  ]
}
